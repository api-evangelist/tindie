  "info": {
    "_postman_id": "88ed6c36-797a-4b32-9ad4-e49cf3da2229",
    "name": "Tindie order API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Tindie's public v1 REST API (Django Tastypie). It exposes three resources: `product` (public catalog listings for a store), and `order` and `orderitem` (a seller's own orders, authenticated). Responses are JSON using the standard Tastypie envelope (`meta` pagination + `objects` array). The `product` resource schema is public; `order` and `orderitem` require API-key authentication and return 401 without credentials.\n\nContact Support:\n Name: Tindie Support",
      "type": "text/plain"
    }
  }
